{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/omni-wheel",
    "sources": "https://github.com/IntelligenceModding/OmniWheel",
    "issues": "https://github.com/IntelligenceModding/OmniWheel/issues",
    "discord": "https://discord.com/invite/JGWkTy6PG8",
    "github": "https://github.com/IntelligenceModding",
    "youtube": "https://www.youtube.com/@intelligencemodding4093"
  },
  "license": "${mod_license}",
  "icon": "icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "de.artemis.omniwheel.OmniWheel"
    ],
    "client": [
